<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/expense_item_bg"
    android:layout_marginBottom="10dp">  <!-- ✅ Increased spacing between transactions -->

    <!-- Amount in Bold -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹100"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"/>

    <!-- Category -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dinner at a restaurant"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <!-- Date & Time -->
    <TextView
        android:id="@+id/tvExpenseDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10 Mar 2025 | 08:30 PM"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvUpiTransaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPI Payment"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:visibility="gone"/>


</LinearLayout>
